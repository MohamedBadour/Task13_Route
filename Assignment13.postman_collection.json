{
  "info": {
    "name": "Assignment13",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth (Rate Limited: 3 req/min)",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"name\": \"Mohamed\", \"email\": \"mohamed13@test.com\", \"password\": \"123456\"}"},
            "url": "http://localhost:3000/auth/signup"
          }
        },
        {
          "name": "Signin (Hit 4 times to test 429 Rate Limit)",
          "event": [
            {
              "listen": "test",
              "script": {"exec": ["var res = pm.response.json(); if(res.token) pm.collectionVariables.set('token', res.token);"]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"mohamed13@test.com\", \"password\": \"123456\"}"},
            "url": "http://localhost:3000/auth/signin"
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send Anonymous Message",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"content\": \"Hello, this is a secret friendly message!\"}"},
            "url": "http://localhost:3000/messages/{{userId}}"
          }
        },
        {
          "name": "Get My Inbox",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "http://localhost:3000/messages"
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "http://localhost:3000/messages/{{messageId}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "token", "value": ""},
    {"key": "userId", "value": "672bb0000000000000000001"},
    {"key": "messageId", "value": ""}
  ]
}
